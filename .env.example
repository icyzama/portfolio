# Server-only Resend configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# A bare email address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=portfolio@your-verified-domain.example
CONTACT_TO_EMAIL=quijanorrq@gmail.com

# Optional, only for a trusted reverse proxy that overwrites this header and
# prevents direct access to the app. Vercel is detected automatically.
# Leave empty for a conservative shared per-instance bucket during local use.
CONTACT_TRUSTED_IP_HEADER=
